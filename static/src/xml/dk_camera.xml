<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Cámara del log: ver static/src/js/dk_camera.js -->

    <!-- El clip del log (arriba y "Adjuntar archivos" dentro de la caja): los archivos originales van a la cola
         del teléfono (dkRawFiles), sin tocar la barra de botones. -->
    <t t-name="stock_picking_sale_buttons.ChatterDkRawFiles" t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="(//FileUploader)[1]" position="attributes">
            <attribute name="dkRawFiles">(files) =&gt; this.dkQueueFiles(files)</attribute>
        </xpath>
        <xpath expr="(//FileUploader)[2]" position="attributes">
            <attribute name="dkRawFiles">(files) =&gt; this.dkQueueFiles(files)</attribute>
        </xpath>
    </t>

    <!-- Aviso de archivos pendientes sobre el clip -->
    <t t-name="stock_picking_sale_buttons.ChatterDkClipBadge" t-inherit="mail.Chatter.attachFiles" t-inherit-mode="extension">
        <xpath expr="//i[hasclass('fa-paperclip')]" position="after">
            <sup t-if="dkCamPending" class="text-danger fw-bold ms-1" title="Archivos guardados en el teléfono, subiendo">
                <i class="fa fa-clock-o"/> <t t-out="dkCamPending"/>
            </sup>
        </xpath>
    </t>

    <!-- Ventana de la cámara: diseño D "cristal" (pantalla completa, todo translúcido) -->
    <t t-name="stock_picking_sale_buttons.DkCameraDialog">
        <Dialog size="'fullscreen'" header="false" footer="false" contentClass="'dkc-dialog'">
            <div class="dkc">
                <!-- visor -->
                <div class="dkc-stage" t-on-touchstart="onTouchStart" t-on-touchmove="onTouchMove" t-on-touchend="onTouchEnd">
                    <video t-ref="video" class="dkc-video" autoplay="" playsinline="" muted=""/>
                    <div class="dkc-grid"/>
                    <div t-if="state.shot" class="dkc-flash"/>
                    <div t-if="state.error" class="dkc-error" t-out="state.error"/>
                </div>

                <!-- barra superior: cerrar · flash · cambiar cámara · archivos · SUBIR -->
                <div class="dkc-top">
                    <button type="button" class="dkc-ib" t-on-click="close" aria-label="Cerrar">
                        <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
                    </button>
                    <button type="button" class="dkc-ib" t-if="state.flashSupported" t-on-click="cycleFlash"
                            t-att-class="{ 'is-on': state.flash === 'on' }" t-att-aria-label="flashLabel" t-att-title="flashLabel">
                        <svg viewBox="0 0 24 24"><path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z"/></svg>
                        <small t-if="state.flash === 'auto'">A</small>
                        <small t-if="state.flash === 'off'" class="dkc-off">✕</small>
                    </button>
                    <button type="button" class="dkc-ib" t-on-click="flip" t-att-disabled="state.recording" aria-label="Cambiar de cámara">
                        <svg viewBox="0 0 24 24"><path d="M20 8a8 8 0 0 0-14-2M4 4v4h4M4 16a8 8 0 0 0 14 2m2 2v-4h-4"/></svg>
                    </button>
                    <span class="dkc-grow"/>
                    <button type="button" class="dkc-upload" t-on-click="uploadAll" t-att-disabled="!items.length or camState.busy">
                        <svg viewBox="0 0 24 24"><path d="M12 16V5m-5 5l5-5 5 5M5 20h14"/></svg>
                        <t t-out="uploadLabel"/>
                    </button>
                </div>

                <!-- avisos -->
                <div class="dkc-notes">
                    <span t-if="state.recording" class="dkc-chip is-rec"><i class="dkc-dot"/> <t t-out="timeLabel"/> / 01:00</span>
                    <span t-if="state.mp" class="dkc-chip">Original · <t t-out="state.mp"/> MP</span>
                    <span t-if="!state.online" class="dkc-chip is-warn">Sin señal · se subirá solo</span>
                </div>

                <!-- zoom -->
                <div class="dkc-zoom" t-if="state.zoomChips.length">
                    <button type="button" t-foreach="state.zoomChips" t-as="z" t-key="z"
                            t-att-class="{ 'on': isZoom(z) }" t-on-click="() => this.setZoom(z)">
                        <t t-out="z === 0.5 ? '.5' : z + '×'"/>
                    </button>
                </div>

                <!-- miniaturas de cristal -->
                <div class="dkc-strip" t-if="items.length">
                    <button type="button" t-foreach="items" t-as="item" t-key="item.id" class="dkc-th"
                            t-on-click="() => this.openReview(item.id)" t-att-aria-label="item.name">
                        <video t-if="item.kind === 'video'" t-att-src="item.url" muted="" playsinline="" preload="metadata"/>
                        <img t-elif="item.kind === 'photo'" t-att-src="item.url" alt="Foto"/>
                        <span t-else="" class="dkc-doc"><i class="fa fa-file-o"/></span>
                        <span t-if="item.kind === 'video'" class="dkc-vid"><i class="fa fa-play"/></span>
                        <span class="dkc-st" t-att-class="dotClass(item)"/>
                    </button>
                </div>

                <!-- base de cristal -->
                <div class="dkc-dock">
                    <div class="dkc-modes">
                        <button type="button" t-att-class="{ 'on': state.mode === 'video' }" t-on-click="() => state.mode = 'video'">VIDEO</button>
                        <button type="button" t-att-class="{ 'on': state.mode === 'photo' }" t-on-click="() => state.mode = 'photo'">FOTO</button>
                    </div>
                    <div class="dkc-row">
                        <button type="button" class="dkc-stack" t-on-click="openLast" t-att-disabled="!items.length" aria-label="Ver lo tomado">
                            <img t-if="lastItem and lastItem.kind === 'photo'" t-att-src="lastItem.url" alt=""/>
                            <video t-elif="lastItem and lastItem.kind === 'video'" t-att-src="lastItem.url" muted="" playsinline="" preload="metadata"/>
                            <span t-if="items.length" class="dkc-count" t-out="items.length"/>
                        </button>
                        <button type="button" class="dkc-shutter" t-att-class="{ 'is-video': state.mode === 'video', 'is-rec': state.recording }"
                                t-on-click="onShutter" aria-label="Disparador"><i/></button>
                        <button type="button" class="dkc-gallery" t-on-click="() => this.nativeRef.el.click()" t-att-disabled="state.recording"
                                aria-label="Elegir fotos, videos o archivos del teléfono" title="Carrete y archivos">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><circle cx="9" cy="10" r="1.6"/><path d="M21 16l-5-5-8 9"/></svg>
                        </button>
                    </div>
                </div>

                <!-- revisar -->
                <div class="dkc-review" t-if="reviewItem">
                    <div class="dkc-rv-media" t-ref="rvMedia">
                        <video t-if="reviewItem.kind === 'video'" t-att-src="reviewItem.url" controls="" playsinline=""/>
                        <img t-elif="reviewItem.kind === 'photo'" t-att-src="reviewItem.url" alt="Foto"/>
                        <div t-else="" class="dkc-doc big"><i class="fa fa-file-o"/><span t-out="reviewItem.name"/></div>
                    </div>
                    <div class="dkc-top">
                        <button type="button" class="dkc-ib" t-on-click="closeReview" aria-label="Volver a la cámara">
                            <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg>
                        </button>
                        <span class="dkc-chip"><t t-out="reviewIndex"/> de <t t-out="items.length"/> · <t t-out="sizeLabel(reviewItem)"/> · original</span>
                        <span class="dkc-grow"/>
                        <button type="button" class="dkc-upload" t-on-click="uploadAll" t-att-disabled="camState.busy">
                            <svg viewBox="0 0 24 24"><path d="M12 16V5m-5 5l5-5 5 5M5 20h14"/></svg>
                            <t t-out="uploadLabel"/>
                        </button>
                    </div>
                    <div class="dkc-sheet">
                        <div class="dkc-strip is-center">
                            <button type="button" t-foreach="items" t-as="item" t-key="item.id" class="dkc-th is-small"
                                    t-att-class="{ 'is-sel': item.id === state.review }" t-on-click="() => this.openReview(item.id)">
                                <video t-if="item.kind === 'video'" t-att-src="item.url" muted="" playsinline="" preload="metadata"/>
                                <img t-elif="item.kind === 'photo'" t-att-src="item.url" alt="Foto"/>
                                <span t-else="" class="dkc-doc"><i class="fa fa-file-o"/></span>
                            </button>
                        </div>
                        <div class="dkc-actions">
                            <button type="button" class="dkc-btn is-no" t-on-click="discard"
                                    t-att-disabled="reviewItem.status === 'uploading'">
                                <svg viewBox="0 0 24 24"><path d="M5 7h14M10 7V4h4v3M7 7l1 13h8l1-13"/></svg>Descartar
                            </button>
                            <button type="button" class="dkc-btn is-yes" t-on-click="closeReview">
                                <svg viewBox="0 0 24 24"><path d="M5 12l5 5 9-10"/></svg>Conservar
                            </button>
                        </div>
                        <div class="dkc-cap">Pellizca o toca dos veces para acercar. Desliza para ver la siguiente.</div>
                    </div>
                </div>

                <div class="dkc-undo" t-if="state.undo">
                    <span>Descartada</span>
                    <button type="button" t-on-click="undoDiscard">Deshacer</button>
                </div>

                <input t-ref="native" type="file" accept="*/*" multiple="" class="d-none" t-on-change="onNativeFiles"/>
            </div>
        </Dialog>
    </t>

    <!-- Al pulsar el clip en celular/tablet: elegir entre cámara y archivos -->
    <t t-name="stock_picking_sale_buttons.DkAttachChoice">
        <Dialog size="'sm'" title="'Agregar al log'" footer="false" contentClass="'dkc-choice'">
            <div class="dkc-choose">
                <button type="button" class="dkc-opt btn btn-primary" t-on-click="pickCamera">
                    <i class="fa fa-camera"/>
                    <span><b>Cámara</b><small>Varias fotos y videos seguidos</small></span>
                </button>
                <button type="button" class="dkc-opt btn btn-secondary" t-on-click="pickFiles">
                    <i class="fa fa-folder-open-o"/>
                    <span><b>Archivos</b><small>Carrete, PDF, Excel…</small></span>
                </button>
                <button t-if="props.attachmentsCount" type="button" class="dkc-opt btn btn-secondary" t-on-click="pickList">
                    <i class="fa fa-paperclip"/>
                    <span><b>Ver adjuntos</b><small><t t-out="props.attachmentsCount"/> archivo(s) en este documento</small></span>
                </button>
                <input t-ref="files" type="file" accept="*/*" multiple="" class="d-none" t-on-change="onFiles"/>
            </div>
        </Dialog>
    </t>
</templates>
