<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Catálogo de Ventas (diseño aprobado el 2026-10-11):
         1. Precio: etiqueta chica "Precio unitario" y el precio grande debajo (antes, una sola línea de texto).
         2. Leyenda de promoción dentro de la tarjeta (debajo de la foto y de la existencia). Se dibuja en el
            espacio `product-ID-promo` que deja la vista views/product_catalog_views.xml, igual que Odoo
            hace con el precio. -->
    <t t-name="stock_picking_sale_buttons.ProductCatalogOrderLinePromo"
       t-inherit="product.ProductCatalogOrderLine" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o_product_catalog_price')]" position="replace">
            <div class="dk-price">
                <div class="dk-price-label">Precio unitario</div>
                <div class="dk-price-value" t-out="price"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-portal]" position="after">
            <t t-portal="`#product-${props.productId}-promo`" t-if="promoText">
                <div t-attf-class="dk-catalog-promo {{ promoClass }}" t-out="promoText"/>
            </t>
        </xpath>
    </t>
</templates>
