<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Panel de Compras (Todos los RFQ): cuarto botón "Por agotar" al lado de Atrasado, en ámbar, con la
         cantidad de productos que llegaron a su mínimo. Abre Compras > Por agotar (ver models/stock_orderpoint_porgotar.py).
         Los demás botones pasan de 3 a 4 por fila (g-col-4 -> g-col-3) para que quepan. -->
    <t t-name="stock_picking_sale_buttons.PurchaseDashboardPorAgotar"
       t-inherit="purchase.PurchaseDashboard" t-inherit-mode="extension">
        <xpath expr="//div[@title='All Draft RFQs']" position="attributes">
            <attribute name="class">g-col-3 p-0</attribute>
        </xpath>
        <xpath expr="//div[@title='All Waiting RFQs']" position="attributes">
            <attribute name="class">g-col-3 p-0</attribute>
        </xpath>
        <xpath expr="//div[@title='All Late RFQs']" position="attributes">
            <attribute name="class">g-col-3 p-0</attribute>
        </xpath>
        <xpath expr="//div[@title='All Late RFQs']" position="after">
            <div class="g-col-3 p-0" t-on-click="openPorAgotar" title="Productos que llegaron a su mínimo">
                <a href="#" class="btn btn-warning w-100 h-100 border-0 rounded-0 text-capitalize text-break fw-normal">
                    <div class="fs-2" t-out="purchaseData['dk_por_agotar']"/>Por agotar
                </a>
            </div>
        </xpath>
        <xpath expr="//div[@title='My Draft RFQs']" position="attributes">
            <attribute name="class">g-col-3 p-0</attribute>
        </xpath>
        <xpath expr="//div[@title='My Waiting RFQs']" position="attributes">
            <attribute name="class">g-col-3 p-0</attribute>
        </xpath>
        <xpath expr="//div[@title='My Late RFQs']" position="attributes">
            <attribute name="class">g-col-3 p-0</attribute>
        </xpath>
    </t>
</templates>
