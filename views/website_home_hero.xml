<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Banner del INICIO (carrusel horizontal) y franja de 3 servicios. La vista "Inicio"
         (website.inicio) los llama con t-call; su script del carrusel usa #dk-slides, .dk-dot,
         .dk-prev y .dk-next, así que se conservan esos nombres. Estilos en shop_redesign.css.
         Fotos en static/src/img/banner/ (el frasco "Mais Cachos" es PNG sin fondo). -->
    <template id="dk_home_hero" name="Inicio: banner y franja de servicios">
        <section class="dk-hero" aria-roledescription="carrusel" aria-label="Destacados">
            <div class="dk-slides" id="dk-slides">

                <!-- 1 · Tintes NNP -->
                <a class="dk-b dk-b-navy" href="/shop/category/326">
                    <div class="dk-b-txt">
                        <span class="dk-b-eyebrow">Lo más pedido por tus clientes</span>
                        <h1>Tintes NNP</h1>
                        <p>Toda la gama de tonos en un solo lugar. Pide por docenas y arma tu surtido.</p>
                        <span class="dk-b-cta">Ver tintes <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="dk-b-cards">
                        <div class="dk-b-card dk-b-side dk-b-left"><img src="/stock_picking_sale_buttons/static/src/img/banner/tinte-violeta.jpg" alt="Tinte NNP violeta"/></div>
                        <div class="dk-b-card dk-b-mid"><img src="/stock_picking_sale_buttons/static/src/img/banner/tinte-negro.jpg" alt="Tinte NNP negro natural"/></div>
                        <div class="dk-b-card dk-b-side dk-b-right"><img src="/stock_picking_sale_buttons/static/src/img/banner/tinte-hombre.jpg" alt="Tinte NNP para caballero"/></div>
                    </div>
                </a>

                <!-- 2 · Tratamientos Skala -->
                <a class="dk-b dk-b-light" href="/shop/category/330">
                    <div class="dk-b-txt">
                        <span class="dk-b-eyebrow">Los que más se venden</span>
                        <h1>Tratamientos Skala</h1>
                        <p>Mais Cachos, Melancia y Morango, los que más piden tus clientes. Mascarilla de 1 kg.</p>
                        <span class="dk-b-cta">Ver tratamientos <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="dk-b-cards">
                        <div class="dk-b-card dk-b-side dk-b-left"><img src="/stock_picking_sale_buttons/static/src/img/banner/skala-melancia.jpg" alt="Tratamiento Skala Melancia"/></div>
                        <div class="dk-b-card dk-b-mid"><img src="/stock_picking_sale_buttons/static/src/img/banner/skala-maiscachos.png" alt="Tratamiento Skala Mais Cachos"/></div>
                        <div class="dk-b-card dk-b-side dk-b-right"><img src="/stock_picking_sale_buttons/static/src/img/banner/skala-morango.jpg" alt="Tratamiento Skala Morango"/></div>
                    </div>
                </a>

                <!-- 3 · Pedido rápido -->
                <a class="dk-b dk-b-navy" href="/pedido-rapido">
                    <div class="dk-b-txt">
                        <span class="dk-b-eyebrow">Pedido rápido</span>
                        <h1>Haz tu pedido en segundos</h1>
                        <p>Escribe tu lista con nombre y cantidad. Nosotros armamos el carrito por ti.</p>
                        <span class="dk-b-cta">Hacer pedido rápido <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="dk-ui" aria-hidden="true">
                        <div class="dk-ui-h">Tu lista</div>
                        <div class="dk-ui-box">tinte 1.0 x 24<br/>trat skala melancia x 12<br class="dk-ui-more"/><span class="dk-ui-more">bubble bath 6</span></div>
                        <div class="dk-ui-ok"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>Esto fue lo que entendimos</div>
                        <div class="dk-ui-rows">
                            <div class="dk-ui-row"><img src="/stock_picking_sale_buttons/static/src/img/banner/tinte-negro.jpg" alt=""/><span>Tinte NNP 1.0 negro natural</span><b>24</b></div>
                            <div class="dk-ui-row"><img src="/stock_picking_sale_buttons/static/src/img/banner/skala-melancia.jpg" alt=""/><span>Trat-Skala 1000gr Melancia</span><b>12</b></div>
                            <div class="dk-ui-row dk-ui-more"><img src="/stock_picking_sale_buttons/static/src/img/banner/bubble-bath.jpg" alt=""/><span>Bubble Bath Kids</span><b>6</b></div>
                        </div>
                    </div>
                </a>

                <!-- 4 · Despachos -->
                <a class="dk-b dk-b-white" href="https://wa.me/50768337354" target="_blank" rel="noopener">
                    <div class="dk-b-txt">
                        <span class="dk-b-eyebrow">Despachos</span>
                        <h1>Llegamos a todo Panamá</h1>
                        <p>De lunes a sábado, de 8:00 a. m. a 5:00 p. m. Escríbenos y coordinamos tu entrega.</p>
                        <span class="dk-b-cta">Escribir por WhatsApp <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
                    </div>
                    <div class="dk-sch" aria-hidden="true">
                        <div class="dk-sch-h">Días de despacho</div>
                        <div class="dk-sch-days">
                            <t t-foreach="[('L','Lun',True),('M','Mar',True),('M','Mié',True),('J','Jue',True),('V','Vie',True),('S','Sáb',True),('D','Dom',False)]" t-as="d">
                                <div t-attf-class="dk-sch-day #{'' if d[2] else 'off'}"><span t-out="d[0]"/><small t-out="d[1]"/></div>
                            </t>
                        </div>
                        <div class="dk-sch-hours"><span>8:00 a. m.</span><span>5:00 p. m.</span></div>
                        <div class="dk-sch-bar"/>
                    </div>
                </a>
            </div>
            <button type="button" class="dk-nav dk-prev" aria-label="Anterior">&#8249;</button>
            <button type="button" class="dk-nav dk-next" aria-label="Siguiente">&#8250;</button>
            <div class="dk-dots">
                <t t-foreach="range(4)" t-as="i"><button type="button" class="dk-dot" t-att-aria-label="'Ir al banner %s' % (i + 1)"/></t>
            </div>
        </section>

        <!-- Franja de 3 servicios, debajo del banner -->
        <section class="dk-svc">
            <a class="dk-svc-i" href="/pedido-rapido">
                <span class="dk-svc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/></svg></span>
                <span class="dk-svc-t"><b>Pedido rápido</b><small>Pega tu lista y listo</small></span>
            </a>
            <a class="dk-svc-i" href="https://wa.me/50768337354" target="_blank" rel="noopener">
                <span class="dk-svc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4l3 3v4h-7"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="16.5" cy="18" r="1.8"/></svg></span>
                <span class="dk-svc-t"><b>Despachos a todo Panamá</b><small>Lunes a sábado, 8:00 a. m. a 5:00 p. m.</small></span>
            </a>
            <a class="dk-svc-i" href="/my/orders">
                <span class="dk-svc-ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16M3 21v-5h5"/></svg></span>
                <span class="dk-svc-t"><b>Repite tu último pedido</b><small>Revisa tus pedidos anteriores</small></span>
            </a>
        </section>
    </template>
</odoo>
