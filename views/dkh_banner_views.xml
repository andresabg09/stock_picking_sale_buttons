<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dkh_banner_list" model="ir.ui.view">
        <field name="name">dkh.banner.list</field>
        <field name="model">dkh.banner</field>
        <field name="arch" type="xml">
            <list string="Banners de la tienda">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slot"/>
                <field name="title"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dkh_banner_form" model="ir.ui.view">
        <field name="name">dkh.banner.form</field>
        <field name="model">dkh.banner</field>
        <field name="arch" type="xml">
            <form string="Banner de la tienda">
                <sheet>
                    <group>
                        <field name="name" placeholder="Ej. Promo tintes octubre"/>
                        <field name="slot"/>
                        <field name="image" widget="image" options="{'size': [0, 200]}"/>
                        <field name="title"/>
                        <field name="subtitle"/>
                        <field name="cta_label"/>
                        <field name="link"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <div class="text-muted">
                        Sube la imagen con el tamaño que indica el espacio. Si no subes imagen, la
                        tienda muestra el diseño rosa/azul con el título y el subtítulo. En el
                        espacio principal puedes crear varios banners y se rotan solos.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dkh_banner" model="ir.actions.act_window">
        <field name="name">Banners de la tienda</field>
        <field name="res_model">dkh.banner</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dkh_banner"
              name="Banners de la tienda"
              parent="sale.menu_sale_config"
              action="action_dkh_banner"
              groups="sales_team.group_sale_manager"
              sequence="91"/>
</odoo>
