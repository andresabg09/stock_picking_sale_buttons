<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Etapa 1 del rediseño de la tienda: cantidad "viva" en cada tarjeta.
         Lo que se escribe queda en el carrito al momento (controllers/shop_live_cart.py
         + static/src/js/shop_live_cart.js). Se monta SOBRE la tarjeta nativa sin
         reemplazar nada de ella: así no rompe otras vistas que se enganchen
         (lista de deseos, comparar, etc.). El ícono de carrito nativo se oculta por CSS. -->
    <template id="products_item_live_qty" inherit_id="website_sale.products_item" name="Tarjeta: cantidad viva y etiquetas">
        <xpath expr="//a[hasclass('oe_product_image_link')]" position="inside">
            <t t-set="dk_pv" t-value="get_product_prices(product)"/>
            <span t-if="product.dk_is_new" class="badge dk-badge dk-badge-new">Nuevo</span>
            <span t-if="dk_pv['price_reduce'] and 'base_price' in dk_pv and dk_pv['base_price'] &gt; dk_pv['price_reduce']" class="badge dk-badge dk-badge-sale">Rebaja</span>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_information')]" position="inside">
            <t t-set="dk_variant" t-value="product._get_first_possible_variant_id()"/>
            <t t-set="dk_can_add" t-value="dk_variant and product.product_variant_count == 1 and product._website_show_quick_add() and (get_product_prices(product)['price_reduce'] or not website.prevent_zero_price_sale)"/>
            <t t-if="dk_can_add">
                <t t-set="dk_order" t-value="website.sale_get_order()"/>
                <t t-set="dk_line" t-value="dk_order.website_order_line.filtered_domain([('product_id', '=', dk_variant)])[:1]"/>
                <t t-set="dk_qty" t-value="int(dk_line.product_uom_qty) if dk_line else 0"/>
                <t t-set="dk_rule" t-value="product._dkh_qty_rule()"/>
                <div class="dk-buy" t-att-data-product-id="dk_variant" t-att-data-min="dk_rule[0]" t-att-data-step="dk_rule[1]" t-att-data-qty="dk_qty" t-att-data-state="'in' if dk_qty else 'out'">
                    <button type="button" class="dk-add btn btn-primary">Agregar</button>
                    <div class="dk-live">
                        <div class="dk-stp">
                            <button type="button" class="dk-minus" aria-label="Menos">&#8722;</button>
                            <input type="text" inputmode="numeric" class="dk-q" t-att-value="dk_qty or dk_rule[0]" aria-label="Cantidad"/>
                            <button type="button" class="dk-plus" aria-label="Más">+</button>
                        </div>
                        <div class="dk-in">
                            <i class="fa fa-check" aria-hidden="true"/> En tu carrito<span class="dk-in-total" t-if="dk_line"> · <span t-out="dk_line._get_cart_display_price()" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></span>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <a t-att-href="product_href" class="dk-options btn btn-outline-primary">Ver opciones</a>
            </t>
        </xpath>
    </template>

    <!-- Píldora flotante con el carrito (Ver carrito). No sale en el carrito ni en el pago. -->
    <template id="layout_cart_pill" inherit_id="website.layout" name="Píldora flotante del carrito">
        <xpath expr="//header" position="after">
            <t t-if="website and website.has_ecommerce_access() and not request.httprequest.path.startswith(('/shop/cart', '/shop/checkout', '/shop/payment', '/shop/confirm', '/shop/address', '/shop/extra_info'))">
                <t t-set="dk_o" t-value="website.sale_get_order()"/>
                <a href="/shop/cart" id="dk-pill" t-attf-class="dk-pill #{'' if dk_o.website_order_line else 'd-none'}" aria-label="Ver carrito">
                    <span class="dk-pill-txt">
                        <b><span class="dk-pill-lines" t-out="len(dk_o.website_order_line)"/> <span class="dk-pill-word" t-out="'producto' if len(dk_o.website_order_line) == 1 else 'productos'"/></b>
                        <small><span class="dk-pill-units" t-out="int(dk_o.cart_quantity)"/> <span class="dk-pill-uword" t-out="'unidad' if int(dk_o.cart_quantity) == 1 else 'unidades'"/> en tu carrito</small>
                    </span>
                    <span class="dk-pill-go">Ver carrito</span>
                </a>
            </t>
        </xpath>
    </template>

    <!-- ================= Etapa 2: ficha de producto ================= -->

    <!-- Tarjeta reutilizable (secciones de sugerencias): foto, nombre, precio y cantidad viva. -->
    <template id="dk_card" name="Tarjeta de producto con cantidad viva">
        <t t-set="dk_info" t-value="p._get_combination_info(only_template=True)"/>
        <t t-set="dk_variant" t-value="p._get_first_possible_variant_id()"/>
        <t t-set="dk_can_add" t-value="dk_variant and p.product_variant_count == 1 and p._website_show_quick_add() and (dk_info['price'] or not website.prevent_zero_price_sale)"/>
        <t t-set="dk_order" t-value="website.sale_get_order()"/>
        <t t-set="dk_line" t-value="dk_order.website_order_line.filtered_domain([('product_id', '=', dk_variant)])[:1] if dk_variant else False"/>
        <t t-set="dk_qty" t-value="int(dk_line.product_uom_qty) if dk_line else 0"/>
        <article class="dk-card">
            <a class="dk-card-img" t-att-href="p.website_url">
                <img t-att-src="website.image_url(p, 'image_512')" t-att-alt="p.name" loading="lazy"/>
                <span t-if="p.dk_is_new" class="badge dk-badge dk-badge-new">Nuevo</span>
                <span t-if="dk_info.get('has_discounted_price')" class="badge dk-badge dk-badge-sale">Rebaja</span>
            </a>
            <div class="dk-card-body">
                <a class="dk-card-name" t-att-href="p.website_url" t-out="p.name.capitalize()"/>
                <div class="dk-card-price">
                    <span t-out="dk_info['price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                    <del t-if="dk_info.get('has_discounted_price')"><span t-out="dk_info['list_price']" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></del>
                </div>
                <t t-if="dk_can_add">
                    <t t-set="dk_rule" t-value="p._dkh_qty_rule()"/>
                    <div class="dk-buy" t-att-data-product-id="dk_variant" t-att-data-min="dk_rule[0]" t-att-data-step="dk_rule[1]" t-att-data-qty="dk_qty" t-att-data-state="'in' if dk_qty else 'out'">
                        <button type="button" class="dk-add btn btn-primary">Agregar</button>
                        <div class="dk-live">
                            <div class="dk-stp">
                                <button type="button" class="dk-minus" aria-label="Menos">&#8722;</button>
                                <input type="text" inputmode="numeric" class="dk-q" t-att-value="dk_qty or dk_rule[0]" aria-label="Cantidad"/>
                                <button type="button" class="dk-plus" aria-label="Más">+</button>
                            </div>
                            <div class="dk-in">
                                <i class="fa fa-check" aria-hidden="true"/> En tu carrito<span class="dk-in-total" t-if="dk_line"> · <span t-out="dk_line._get_cart_display_price()" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></span>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <a t-att-href="p.website_url" class="dk-options btn btn-outline-primary">Ver opciones</a>
                </t>
            </div>
        </article>
    </template>

    <!-- Secciones debajo de la ficha: misma línea + "Te puede interesar". -->
    <template id="dk_product_sections" name="Ficha: secciones de sugerencias">
        <t t-set="dk_sibs" t-value="product._dk_siblings(8)"/>
        <t t-set="dk_sugs" t-value="product._dk_suggestions(8, dk_sibs)"/>
        <div class="dk-sections container">
            <section t-if="dk_sibs" class="dk-sec">
                <div class="dk-sec-head"><h2>De la misma línea</h2></div>
                <div class="dk-grid">
                    <t t-foreach="dk_sibs" t-as="sp">
                        <t t-call="stock_picking_sale_buttons.dk_card"><t t-set="p" t-value="sp"/></t>
                    </t>
                </div>
            </section>
            <section t-if="dk_sugs" class="dk-sec">
                <div class="dk-sec-head"><h2>Te puede interesar</h2></div>
                <div class="dk-grid">
                    <t t-foreach="dk_sugs" t-as="sg">
                        <t t-call="stock_picking_sale_buttons.dk_card"><t t-set="p" t-value="sg"/></t>
                    </t>
                </div>
            </section>
        </div>
    </template>

    <!-- Ficha: cantidad viva (queda en el carrito al momento) montada ANTES de la caja nativa,
         que se oculta por CSS cuando existe (.dk-pbox ~ #o_wsale_cta_wrapper). Solo productos de
         una sola variante; con variantes se sigue usando la caja nativa. -->
    <template id="product_live_buybox" inherit_id="website_sale.product" name="Ficha: cantidad viva y sugerencias">
        <xpath expr="//h1[@itemprop='name']" position="before">
            <div class="dk-eyebrow">
                <span t-if="product.dk_is_new" class="badge dk-badge-inline">Nuevo</span>
                <span t-if="product.public_categ_ids" t-out="product.public_categ_ids[0].name"/>
            </div>
        </xpath>
        <xpath expr="//h1[@itemprop='name']" position="after">
            <div class="dk-meta">
                <span>Referencia <b t-out="product.name"/></span>
                <span t-if="product_variant.barcode">· Código de barras <b t-out="product_variant.barcode"/></span>
            </div>
        </xpath>
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="before">
            <t t-if="product._is_add_to_cart_possible() and product.product_variant_count == 1 and product_variant and not combination_info['prevent_zero_price_sale']">
                <t t-set="dk_order" t-value="website.sale_get_order()"/>
                <t t-set="dk_line" t-value="dk_order.website_order_line.filtered_domain([('product_id', '=', product_variant.id)])[:1]"/>
                <t t-set="dk_qty" t-value="int(dk_line.product_uom_qty) if dk_line else 0"/>
                <div class="dk-pbox">
                    <div class="dk-pbox-title">Cantidad</div>
                    <t t-set="dk_rule" t-value="product_variant._dkh_qty_rule()"/>
                    <div class="dk-buy dk-buy-lg" t-att-data-product-id="product_variant.id" t-att-data-min="dk_rule[0]" t-att-data-step="dk_rule[1]" t-att-data-qty="dk_qty" t-att-data-state="'in' if dk_qty else 'out'">
                        <button type="button" class="dk-add btn btn-primary btn-lg">Agregar al carrito</button>
                        <div class="dk-live">
                            <div class="dk-stp">
                                <button type="button" class="dk-minus" aria-label="Menos">&#8722;</button>
                                <input type="text" inputmode="numeric" class="dk-q" t-att-value="dk_qty or dk_rule[0]" aria-label="Cantidad"/>
                                <button type="button" class="dk-plus" aria-label="Más">+</button>
                            </div>
                            <div class="dk-in">
                                <i class="fa fa-check" aria-hidden="true"/> En tu carrito<span class="dk-in-total" t-if="dk_line"> · <span t-out="dk_line._get_cart_display_price()" t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/></span>
                            </div>
                        </div>
                        <div class="dk-presets">
                            <t t-foreach="([10, 25, 50, 100] if dk_rule[2] else [12, 24, 48, 96])" t-as="pq">
                                <button type="button" class="dk-pre" t-att-data-qty="pq" t-out="pq"/>
                            </t>
                        </div>
                    </div>
                    <div t-attf-class="dk-actions #{'' if dk_order.website_order_line else 'd-none'}">
                        <a href="/shop/cart" class="btn btn-outline-primary">Ver carrito</a>
                        <a href="/shop/checkout?try_skip_step=true" class="btn btn-primary">Finalizar compra</a>
                    </div>
                    <div class="dk-note">Despachos de lunes a sábado, de 8:00 a. m. a 5:00 p. m.</div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@id='product_full_description']" position="after">
            <t t-call="stock_picking_sale_buttons.dk_product_sections"/>
        </xpath>
    </template>
</odoo>
