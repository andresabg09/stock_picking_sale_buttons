<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_confirm_payment_wizard_form" model="ir.ui.view">
        <field name="name">sale.confirm.payment.wizard.form</field>
        <field name="model">sale.confirm.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar orden de venta">
                <div class="alert alert-warning" role="alert">
                    Para confirmar esta orden hace falta la <strong>Forma de Pago</strong>.
                </div>
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="payment_method" required="1"/>
                    <field name="special_delivery_date" placeholder="Solo si el cliente pidió un día especial"/>
                    <field name="includes_itbms" widget="boolean_toggle"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirmar orden" type="object" class="btn-primary"/>
                    <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
