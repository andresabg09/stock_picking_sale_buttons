<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_bulk_email_wizard_form" model="ir.ui.view">
        <field name="name">purchase.bulk.email.wizard.form</field>
        <field name="model">purchase.bulk.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Órdenes Individuales">
                <div class="alert alert-info" role="alert">
                    <strong>Proveedor actual:</strong> <field name="current_partner_id" readonly="1" nolabel="1"/>
                    <br/>
                    <strong>Órdenes en este correo:</strong>
                    <field name="current_order_ids" readonly="1" nolabel="1" widget="many2many_tags"/>
                    <br/>
                    <strong>Proveedores restantes después de este:</strong> <field name="remaining_count" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="email_to" placeholder="correo@proveedor.com"/>
                    <field name="email_cc" placeholder="correo1@x.com, correo2@x.com"/>
                    <field name="subject"/>
                </group>
                <field name="body"/>
                <group string="Adjuntos">
                    <field name="attachment_ids" widget="many2many_binary"/>
                </group>
                <footer>
                    <button name="action_send_and_continue" string="Enviar y continuar con el siguiente" type="object" class="btn-primary"/>
                    <button name="action_close" string="Cerrar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
