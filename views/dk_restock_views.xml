<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Compras > Por agotar (diseño "Opción A" aprobado por Andrés en el lienzo
         claude.ai/artifact/2gYoPopN1SaQm31JuZLVsr). Ver models/dk_restock.py.
         - Computadora/tablet: lista de productos con "A pedir" editable.
         - Celular: tarjetas (Odoo muestra el kanban del campo en pantallas chicas); tocar la tarjeta abre
           la ventana donde se cambia "A pedir" e "Incluir". -->

    <!-- El mínimo se define por producto: columna en la lista de Productos (se puede editar varios a la vez
         con multi_edit) y campo en la pestaña Inventario del producto. -->
    <record id="view_product_template_tree_dk_min_qty" model="ir.ui.view">
        <field name="name">product.template.list.dk.min.qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="dk_min_qty" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_product_template_form_dk_min_qty" model="ir.ui.view">
        <field name="name">product.template.form.dk.min.qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="inventory" position="inside">
                <group string="Aviso de reabastecimiento" invisible="not is_storable">
                    <field name="dk_min_qty"/>
                </group>
            </page>
        </field>
    </record>

    <!-- Pantalla Por agotar -->
    <record id="view_dk_restock_form" model="ir.ui.view">
        <field name="name">dk.restock.form</field>
        <field name="model">dk.restock</field>
        <field name="arch" type="xml">
            <form string="Por agotar" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_order" type="object" string="Pedir a proveedor" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="alert alert-info" role="alert">
                        <strong>Cómo se calcula:</strong> Disponible = en bodega − comprometido en ventas + por llegar
                        (solo Dianke, sin Nevada). Sugerido = lo que falta para quedar en tu mínimo después de cubrir
                        lo ya vendido. Cambia “A pedir” si quieres surtir de más y desmarca “Incluir” lo que no
                        quieras pedir ahora.
                    </div>
                    <field name="line_ids" nolabel="1" mode="list,kanban">
                        <list editable="bottom" create="0" delete="0" decoration-danger="state == 'out'"
                              decoration-warning="state == 'low'">
                            <field name="selected" widget="boolean_toggle"/>
                            <field name="product_id"/>
                            <field name="state" widget="badge" decoration-danger="state == 'out'"
                                   decoration-warning="state == 'low'"/>
                            <field name="on_hand" optional="show"/>
                            <field name="committed" optional="show"/>
                            <field name="incoming" optional="show"/>
                            <field name="available" decoration-danger="available &lt; 0" decoration-bf="1"/>
                            <field name="min_qty"/>
                            <field name="suggested" decoration-bf="1"/>
                            <field name="qty_to_order" decoration-bf="1"/>
                            <field name="note" optional="show"/>
                            <field name="nevada_label" optional="show"/>
                            <field name="vendor_id" optional="show"/>
                            <field name="unit_price" optional="hide"/>
                            <field name="subtotal" sum="Total estimado"/>
                        </list>
                        <kanban create="0" delete="0">
                            <field name="state"/>
                            <field name="selected"/>
                            <field name="nevada_label"/>
                            <field name="nevada_tone"/>
                            <field name="note"/>
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex gap-3">
                                        <field name="image" widget="image" options="{'size': [77, 77], 'img_class': 'object-fit-contain'}"/>
                                        <div class="flex-grow-1" style="min-width:0">
                                            <field name="product_id" class="fw-bold"/>
                                            <span t-attf-class="badge mt-1 text-bg-#{record.state.raw_value == 'out' ? 'danger' : 'warning'}">
                                                <field name="state"/>
                                            </span>
                                            <span t-if="!record.selected.raw_value" class="badge text-bg-secondary mt-1">No incluido</span>
                                        </div>
                                    </div>
                                    <div class="row g-1 mt-2 text-center">
                                        <div class="col-4"><div class="bg-100 rounded p-1"><div class="small">En bodega (existencia)</div><b><field name="on_hand"/></b></div></div>
                                        <div class="col-4"><div class="bg-100 rounded p-1"><div class="small">Comprometido</div><b><field name="committed"/></b></div></div>
                                        <div class="col-4"><div class="bg-100 rounded p-1"><div class="small">Por llegar</div><b><field name="incoming"/></b></div></div>
                                        <div class="col-4"><div class="bg-100 rounded p-1"><div class="small">Disponible</div><b><field name="available"/></b></div></div>
                                        <div class="col-4"><div class="bg-100 rounded p-1"><div class="small">Mínimo</div><b><field name="min_qty"/></b></div></div>
                                        <div class="col-4"><div t-attf-class="rounded p-1 #{record.nevada_label.raw_value ? 'bg-warning-subtle' : 'bg-100'}"><div class="small">Nevada</div><b><t t-out="record.nevada_label.raw_value || '—'"/></b></div></div>
                                    </div>
                                    <div class="border rounded mt-2">
                                        <div class="d-flex justify-content-between p-2">
                                            <div><div class="small">A pedir</div><span class="fs-4 fw-bold"><field name="qty_to_order"/></span></div>
                                            <div class="text-end"><div class="small">Costo estimado</div><b><field name="subtotal"/></b></div>
                                        </div>
                                        <div class="p-2 fw-bold text-bg-light border-top">
                                            Sugerido: <field name="suggested"/>
                                            <div t-if="record.note.raw_value" class="small fw-normal"><field name="note"/></div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form>
                            <group>
                                <field name="product_id"/>
                                <field name="state" widget="badge" decoration-danger="state == 'out'" decoration-warning="state == 'low'"/>
                                <field name="available"/>
                                <field name="min_qty"/>
                                <field name="suggested"/>
                                <field name="note"/>
                                <field name="nevada_label"/>
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="qty_to_order"/>
                            </group>
                        </form>
                    </field>
                    <group class="justify-content-end">
                        <group class="oe_subtotal_footer">
                            <field name="selected_count"/>
                            <field name="total_units"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Pop-up de confirmación -->
    <record id="view_dk_restock_order_wizard_form" model="ir.ui.view">
        <field name="name">dk.restock.order.wizard.form</field>
        <field name="model">dk.restock.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear pedido a proveedor">
                <field name="summary" nolabel="1"/>
                <group>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Crear borrador" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Se abre con un código (arma las líneas al momento); lo usan el menú y el botón del panel de Compras -->
    <record id="action_dk_por_agotar" model="ir.actions.server">
        <field name="name">Por agotar</field>
        <field name="model_id" ref="model_dk_restock"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_dk_por_agotar"
              name="Por agotar"
              parent="purchase.menu_procurement_management"
              action="action_dk_por_agotar"
              groups="purchase.group_purchase_user"
              sequence="5"/>
</odoo>
