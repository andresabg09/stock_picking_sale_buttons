<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_images" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.images</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Forma de pago y fecha especial de entrega -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="custom_payment_method"/>
                <field name="custom_special_delivery_date"/>
            </xpath>

            <!-- Botón para enviar manualmente a Dianke (solo si ya está confirmada) -->
            <xpath expr="//header/button[@name='action_confirm']" position="after">
                <button name="action_send_dianke_export_now" string="Enviar a Dianke ahora" type="object"
                        invisible="state != 'sale'" class="btn-secondary" data-hotkey="d"/>
            </xpath>

            <!-- Aviso de envío a Dianke: visible de inmediato al abrir la orden -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-info mb-0" role="alert" invisible="not custom_dianke_exported">
                    <i class="fa fa-check-circle me-1"/>
                    Enviado a Dianke el <field name="custom_dianke_exported_date" readonly="1" class="oe_inline"/>
                    <span invisible="not custom_dianke_exported_by">
                        por <field name="custom_dianke_exported_by" readonly="1" class="oe_inline"/>
                    </span>.
                </div>
            </xpath>

            <!-- Foto antes de product_template_id -->
            <xpath expr="//list//field[@name='product_template_id']" position="before">
                <field name="custom_product_image" widget="image" options="{'size': [95, 95]}" string="Foto" readonly="1"/>
            </xpath>

            <!-- Código y Promo después de product_template_id -->
            <xpath expr="//list//field[@name='product_template_id']" position="after">
                <field name="custom_product_barcode" string="Código"/>
                <field name="custom_promo_status" string="Promo" readonly="1"
                       decoration-success="custom_promo_status and 'COMPLETA' in custom_promo_status"
                       decoration-danger="custom_promo_status and 'COMPLETA' not in custom_promo_status"/>
            </xpath>

            <!-- Wrap en columna producto -->
            <xpath expr="//list//field[@name='product_template_id']" position="attributes">
                <attribute name="style">white-space: normal; word-break: break-word;</attribute>
            </xpath>

            <!-- Sin paginación -->
            <xpath expr="//list" position="attributes">
                <attribute name="limit">9999</attribute>
            </xpath>

            <!-- KANBAN MÓVIL: rediseño profesional con controles recuperados -->
            <xpath expr="//field[@name='order_line']//kanban" position="replace">
                <kanban class="o_kanban_mobile" limit="9999">
                    <field name="display_type"/>
                    <field name="custom_product_image"/>
                    <field name="custom_product_barcode"/>
                    <field name="custom_promo_status"/>
                    <field name="name"/>
                    <field name="price_subtotal"/>
                    <field name="price_unit"/>
                    <field name="product_uom_qty"/>
                    <field name="product_uom"/>
                    <field name="currency_id"/>
                    <control>
                        <create name="add_product_control" string="Agregar producto"/>
                        <create name="add_section_control" string="Agregar sección" context="{'default_display_type': 'line_section'}"/>
                        <create name="add_note_control" string="Agregar nota" context="{'default_display_type': 'line_note'}"/>
                        <button name="action_add_from_catalog" context="{'order_id': parent.id}" string="Catálogo" type="object" class="btn-secondary"/>
                    </control>
                    <templates>
                        <t t-name="card">
                            <t t-if="!record.display_type.raw_value">
                                <div class="d-flex gap-2 p-1">
                                    <div style="width:95px;height:95px;flex-shrink:0;border-radius:8px;overflow:hidden;background:#f5f5f5;display:flex;align-items:center;justify-content:center;">
                                        <img t-if="record.custom_product_image.raw_value"
                                             t-att-src="'/web/image?model=sale.order.line&amp;id=' + record.id.raw_value + '&amp;field=custom_product_image'"
                                             alt="Producto"
                                             style="width:95px;height:95px;object-fit:contain;"/>
                                        <i t-else="" class="fa fa-image fa-2x text-muted"/>
                                    </div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="fw-bold" style="font-size:0.85rem;white-space:normal;word-break:break-word;">
                                            <field name="product_id"/>
                                        </div>
                                        <t t-set="_product_display_name" t-value="(record.product_id.value and record.product_id.value.display_name) || record.product_id.value || ''"/>
                                        <div t-if="record.name.raw_value and record.name.raw_value.trim() !== _product_display_name.trim()"
                                             class="text-muted"
                                             style="font-size:0.75rem;white-space:normal;word-break:break-word;">
                                            <field name="name"/>
                                        </div>
                                        <div t-if="record.custom_product_barcode.raw_value"
                                             class="text-muted d-flex align-items-center gap-1 mt-1"
                                             style="font-size:0.75rem;">
                                            <i class="fa fa-barcode" title="Código de barras"/>
                                            <span t-out="record.custom_product_barcode.raw_value"/>
                                        </div>
                                        <div class="text-muted mt-1" style="font-size:0.78rem;">
                                            Cantidad: <field name="product_uom_qty"/>
                                            <field name="product_uom" groups="uom.group_uom"/>
                                        </div>
                                        <div class="text-muted" style="font-size:0.78rem;">
                                            Precio unitario: <field name="price_unit"/>
                                        </div>
                                        <div class="d-flex justify-content-end mt-1">
                                            <span class="fw-bold" style="font-size:0.88rem;">
                                                <field name="price_subtotal" widget="monetary"/>
                                            </span>
                                        </div>
                                        <div t-if="record.custom_promo_status.raw_value" class="mt-1">
                                            <span t-att-class="'badge px-2 py-1 ' + (record.custom_promo_status.raw_value.includes('\u2705') ? 'text-bg-success' : 'text-bg-danger')"
                                                  style="font-size:0.72rem;white-space:normal;">
                                                <field name="custom_promo_status"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div t-elif="record.display_type.raw_value === 'line_section' or record.display_type.raw_value === 'line_note'">
                                <div t-attf-class="px-2 py-1 {{ record.display_type.raw_value === 'line_section' ? 'fw-bold text-uppercase small' : 'fst-italic text-muted small' }}">
                                    <field name="name"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </xpath>
        </field>
    </record>

    <!-- Forzar vista lista en ventas, sin paginación -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="limit">1000000</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="limit">1000000</field>
    </record>

    <!-- ================================================================
         Visibilidad de envíos a Dianke en Ventas: lista, kanban y
         filtros de búsqueda, para Órdenes y Cotizaciones (mismo campo
         custom_dianke_exported en las dos). Xml id de las vistas core
         confirmados por SSH con Andrés (ver historial en CLAUDE.md).
         ================================================================ -->

    <!-- Lista RAÍZ: se hereda automáticamente en TODAS las variantes de
         lista de Órdenes y Cotizaciones (con o sin banner de onboarding),
         sin depender de cuál esté activa en cada momento. -->
    <record id="view_order_list_dianke" model="ir.ui.view">
        <field name="name">sale.order.list.dianke</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-warning">state == 'sale' and not custom_dianke_exported</attribute>
            </xpath>
            <xpath expr="//list" position="inside">
                <field name="custom_dianke_exported" string="Dianke" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="custom_dianke_exported_date" string="Fecha envío Dianke" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Kanban raíz: heredado tanto por Órdenes como por Cotizaciones -->
    <record id="view_sale_order_kanban_dianke" model="ir.ui.view">
        <field name="name">sale.order.kanban.dianke</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="custom_dianke_exported"/>
                <field name="custom_dianke_exported_date"/>
            </xpath>
            <xpath expr="//div[@class='d-flex align-items-baseline mb-2']" position="after">
                <div t-if="record.custom_dianke_exported.raw_value"
                     class="d-flex align-items-center gap-1 mb-1 text-success" style="font-size:0.78rem;">
                    <i class="fa fa-check-circle"/>
                    <span>Dianke: <field name="custom_dianke_exported_date"/></span>
                </div>
                <div t-elif="record.state.raw_value === 'sale'"
                     class="d-flex align-items-center gap-1 mb-1 text-warning" style="font-size:0.78rem;">
                    <i class="fa fa-exclamation-circle"/>
                    <span>Pendiente de Dianke</span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Filtros de búsqueda: Órdenes -->
    <record id="view_sales_order_filter_dianke_orders" model="ir.ui.view">
        <field name="name">sale.order.search.dianke.orders</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="dianke_pending" string="Pendientes de Dianke"
                        domain="[('state','=','sale'),('custom_dianke_exported','=',False)]"/>
                <filter name="dianke_sent" string="Enviados a Dianke"
                        domain="[('custom_dianke_exported','=',True)]"/>
                <filter name="group_dianke_exported" string="Enviado a Dianke"
                        context="{'group_by':'custom_dianke_exported'}"/>
            </xpath>
        </field>
    </record>

    <!-- Filtros de búsqueda: Cotizaciones -->
    <record id="view_sales_order_filter_dianke_quotations" model="ir.ui.view">
        <field name="name">sale.order.search.dianke.quotations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="dianke_pending" string="Pendientes de Dianke"
                        domain="[('state','=','sale'),('custom_dianke_exported','=',False)]"/>
                <filter name="dianke_sent" string="Enviados a Dianke"
                        domain="[('custom_dianke_exported','=',True)]"/>
                <filter name="group_dianke_exported" string="Enviado a Dianke"
                        context="{'group_by':'custom_dianke_exported'}"/>
            </xpath>
        </field>
    </record>
</odoo>
