<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catálogo de productos (botón "Catálogo" de Ventas): en vez de "En mano" (lo que hay en bodega,
         sin restar lo ya prometido a otros pedidos) se muestra lo DISPONIBLE (libre). Además deja un
         espacio para la leyenda de promoción en vivo (ver static/src/js/catalog_promo.js). -->
    <record id="view_product_kanban_catalog_free_qty" model="ir.ui.view">
        <field name="name">product.view.kanban.catalog.inherit.free.qty</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.product_view_kanban_catalog"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <field name="is_storable" position="after">
                <field name="free_qty"/>
                <field name="qty_available"/>
            </field>
            <xpath expr="//div[@name='o_kanban_qty_available']" position="replace">
                <div t-if="record.is_storable.raw_value" name="o_kanban_qty_available" class="mt-1">
                    <span t-attf-class="badge {{ record.free_qty.raw_value &lt;= 0 ? 'text-bg-danger' : (record.free_qty.raw_value &lt;= 5 ? 'text-bg-warning' : 'text-bg-success') }}">
                        <t t-if="record.free_qty.raw_value &lt;= 0">Sin existencia</t>
                        <t t-else="">Disponible: <field name="free_qty"/></t>
                    </span>
                    <span class="text-muted ms-2 small">En bodega: <field name="qty_available"/></span>
                </div>
                <div name="o_kanban_promo" t-attf-id="product-{{record.id.raw_value}}-promo"/>
            </xpath>
        </field>
    </record>
</odoo>
