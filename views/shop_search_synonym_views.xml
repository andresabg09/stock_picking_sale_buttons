<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shop_search_synonym_tree" model="ir.ui.view">
        <field name="name">shop.search.synonym.tree</field>
        <field name="model">shop.search.synonym</field>
        <field name="arch" type="xml">
            <list string="Sinónimos de búsqueda">
                <field name="name"/>
                <field name="words"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_shop_search_synonym_form" model="ir.ui.view">
        <field name="name">shop.search.synonym.form</field>
        <field name="model">shop.search.synonym</field>
        <field name="arch" type="xml">
            <form string="Sinónimos de búsqueda">
                <sheet>
                    <group>
                        <field name="name" placeholder="Ej. Shampú"/>
                        <field name="words" placeholder="shp, shampu, champu, shampoo"/>
                        <field name="active"/>
                    </group>
                    <div class="text-muted">
                        Cuando un cliente busca en la tienda cualquiera de estas palabras,
                        también se le muestran los productos que tengan cualquiera de las otras.
                        Sirve sobre todo para las abreviaturas del catálogo (SHP, TRAT, ACD...).
                        Los cambios aplican de inmediato, sin tocar nada más.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_shop_search_synonym" model="ir.actions.act_window">
        <field name="name">Sinónimos de búsqueda</field>
        <field name="res_model">shop.search.synonym</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_shop_search_synonym"
              name="Sinónimos de búsqueda (tienda)"
              parent="sale.menu_sale_config"
              action="action_shop_search_synonym"
              groups="sales_team.group_sale_manager"
              sequence="90"/>
</odoo>
