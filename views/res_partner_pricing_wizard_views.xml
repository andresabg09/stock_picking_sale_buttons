<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_pricing_wizard_form" model="ir.ui.view">
        <field name="name">res.partner.pricing.wizard.form</field>
        <field name="model">res.partner.pricing.wizard</field>
        <field name="arch" type="xml">
            <form string="Precios pactados por cliente">
                <div class="alert alert-info" role="alert">
                    <strong>Cliente actual:</strong>
                    <field name="current_partner_id" readonly="1" nolabel="1"/>
                    <br/>
                    <strong>Clientes restantes después de este:</strong>
                    <field name="remaining_count" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not current_pricelist_name">
                    Este cliente ya tiene asignada la lista de precios
                    "<field name="current_pricelist_name" readonly="1" nolabel="1"/>" —
                    si guardas, se reemplaza por la nueva lista de precios pactados.
                </div>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id" readonly="1"/>
                        <field name="historial_precios" readonly="1"/>
                        <field name="precio_elegido"/>
                        <field name="incluir"/>
                    </list>
                </field>
                <footer>
                    <button name="action_save_and_continue" string="Guardar y siguiente cliente" type="object" class="btn-primary"/>
                    <button name="action_skip_partner" string="Omitir este cliente" type="object" class="btn-secondary"/>
                    <button name="action_close" string="Cerrar" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
