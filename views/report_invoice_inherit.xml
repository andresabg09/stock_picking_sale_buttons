<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_inherit" inherit_id="account.report_invoice_document">

        <!-- Agregar columna Imagen ANTES de Description -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_image" class="text-start" style="width:90px;"></th>
        </xpath>

        <!-- Agregar columna Código de Barras DESPUÉS de Description -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_barcode" class="text-start"><span>Código</span></th>
        </xpath>

        <!-- Agregar celda imagen en filas de producto -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="before">
            <td name="td_image" style="width:90px;">
                <img t-if="line.product_id.image_1024"
                     t-att-src="image_data_uri(line.product_id.image_1024)"
                     style="max-height:90px;max-width:90px;object-fit:contain;"/>
            </td>
        </xpath>

        <!-- Agregar celda código de barras después de descripción -->
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_barcode" class="text-start">
                <span t-if="line.product_id.barcode" t-out="line.product_id.barcode"/>
            </td>
        </xpath>

        <!-- Impuestos condicional -->
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <t t-set="display_taxes" t-value="any(line.tax_ids for line in o.invoice_line_ids)"/>
            <th name="th_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
        </xpath>

        <xpath expr="//td[@name='td_taxes']" position="replace">
            <td name="td_taxes" t-if="display_taxes" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }} {{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                <span t-out="taxes" id="line_tax_ids">Tax 15%</span>
            </td>
        </xpath>

    </template>
</odoo>
