<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de servidor: enviar a Dianke desde el listado de Ventas
         (selecciona varias órdenes confirmadas y usa Acción > Enviar a Dianke) -->
    <record id="action_server_send_dianke_export" model="ir.actions.server">
        <field name="name">Enviar a Dianke (Excel)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_dianke_export_now()</field>
    </record>

    <!-- El envío a Dianke es 100% manual por ahora (pedido explícito de
         Andrés, 2026-09-05): botón "Enviar a Dianke ahora" en la orden y
         esta acción masiva desde el listado de Ventas.

         El método sale.order._cron_send_dianke_export() ya existe en el
         código Python para el día que se quiera automatizar, pero
         DELIBERADAMENTE no hay un registro ir.cron aquí todavía: los
         campos de ir.cron cambiaron entre versiones de Odoo (ya tumbó la
         base de datos dos veces por campos que no existen en esta
         versión: primero el eval de nextcall, después "numbercall").
         Antes de volver a crear el cron, pedirle a Andrés el resultado de
         este comando SSH para confirmar los campos exactos de ir.cron en
         su instalación:

           docker exec [contenedor_odoo] odoo shell -d shalom
             (dentro del shell: print(env['ir.cron']._fields.keys()) )

         (o revisar la definición de la clase IrCron en el addon base de
         esa versión dentro del contenedor). No adivinar de nuevo. -->
</odoo>
