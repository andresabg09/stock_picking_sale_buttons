<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de servidor: enviar a Dianke desde el listado de Ventas
         (selecciona varias órdenes confirmadas y usa Acción > Enviar a Dianke) -->
    <record id="action_server_send_dianke_export" model="ir.actions.server">
        <field name="name">Enviar a Dianke (Excel)</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_dianke_export_now()</field>
    </record>

    <!-- Job automático: todos los días a las 11:59pm envía a Dianke las
         órdenes de venta confirmadas que aún no se le han mandado -->
    <record id="ir_cron_send_dianke_export" model="ir.cron">
        <field name="name">Dianke: enviar pedidos confirmados pendientes</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_dianke_export()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
        <field name="nextcall" eval="datetime.datetime.now().replace(hour=23, minute=59, second=0, microsecond=0)"/>
    </record>
</odoo>
