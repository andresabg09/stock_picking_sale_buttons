<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de servidor: traer precios pactados de facturas anteriores
         desde el listado de Contactos (selecciona varios clientes y usa
         Acción > Traer precios pactados de facturas) -->
    <record id="action_server_traer_precios_pactados" model="ir.actions.server">
        <field name="name">Traer precios pactados de facturas</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_traer_precios_pactados()</field>
    </record>
</odoo>
