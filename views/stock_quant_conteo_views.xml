<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inventario > Operaciones > Inventario físico: foto del producto, columnas esenciales que caben en el
         celular (Producto, Existencia, Contado, Diferencia), estado de color por línea y filtros rápidos para
         los recuentos. "Pedir recuento", Contado, Diferencia y Aplicar son los de Odoo; "Aplicar" queda solo
         para el Administrador de Inventario (ver models/stock_quant_conteo.py). Estilos en responsive_lists.css. -->
    <record id="view_stock_quant_inventory_dk" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.dk</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Aplicar: solo el administrador (quien cuenta no aplica) -->
            <xpath expr="//button[@name='action_apply_all']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
            <xpath expr="//header/button[@name='stock.action_stock_inventory_adjustement_name']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
            <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
            <!-- Pedir recuento: botón principal (aparece al marcar las líneas; "seleccionar todo" sirve con filtros) -->
            <xpath expr="//header/button[@name='stock.action_stock_request_count']" position="attributes">
                <attribute name="string">Pedir recuento</attribute>
                <attribute name="class">btn btn-primary</attribute>
            </xpath>

            <!-- Foto al principio de la fila -->
            <field name="location_id" position="before">
                <field name="dk_image" widget="image" options="{'size': [56, 56], 'img_class': 'object-fit-contain'}"
                       string="Foto" readonly="1"/>
            </field>
            <!-- Lo que casi no se usa queda en el selector de columnas -->
            <field name="owner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="quantity" position="attributes">
                <attribute name="string">Existencia</attribute>
            </field>
            <field name="inventory_quantity" position="attributes">
                <attribute name="string">Contado</attribute>
            </field>
            <field name="inventory_diff_quantity" position="attributes">
                <attribute name="string">Diferencia</attribute>
            </field>
            <field name="inventory_diff_quantity" position="after">
                <field name="dk_state" widget="badge" decoration-success="dk_state == 'ok'"
                       decoration-danger="dk_state == 'diff'" decoration-muted="dk_state == 'pending'"
                       optional="show"/>
            </field>
        </field>
    </record>

    <!-- Filtros rápidos de los recuentos -->
    <record id="view_stock_quant_search_dk" model="ir.ui.view">
        <field name="name">stock.quant.search.dk</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <filter name="to_apply" position="after">
                <filter name="dk_sin_contar" string="Sin contar" domain="[('inventory_quantity_set', '=', False)]"/>
                <filter name="dk_contados" string="Contados" domain="[('inventory_quantity_set', '=', True)]"/>
                <filter name="dk_con_diferencia" string="Con diferencia"
                        domain="[('inventory_quantity_set', '=', True), ('inventory_diff_quantity', '!=', 0)]"/>
            </filter>
        </field>
    </record>
</odoo>
