<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_inherit" inherit_id="stock.report_delivery_document">

        <!-- TABLA PENDIENTE: header imagen antes de Product, código después -->
        <xpath expr="//table[@name='stock_move_table']//th[@name='th_sm_product']" position="before">
            <th name="th_sm_image" style="width:90px;"></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//th[@name='th_sm_product']" position="after">
            <th name="th_sm_barcode"><strong>Código</strong></th>
        </xpath>

        <!-- TABLA PENDIENTE: celda imagen y código por fila -->
        <xpath expr="//table[@name='stock_move_table']//tr//td[position()=1]" position="before">
            <td style="width:90px;">
                <img t-if="move.product_id.image_1024"
                     t-att-src="image_data_uri(move.product_id.image_1024)"
                     style="max-height:90px;max-width:90px;object-fit:contain;"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//tr//td[position()=1]" position="after">
            <td><span t-if="move.product_id.barcode" t-out="move.product_id.barcode"/></td>
        </xpath>

        <!-- TABLA DONE: header imagen antes de Product, código después -->
        <xpath expr="//table[@name='stock_move_line_table']//th[@name='th_sml_product']" position="before">
            <th name="th_sml_image" style="width:90px;"></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']//th[@name='th_sml_product']" position="after">
            <th name="th_sml_barcode"><strong>Código</strong></th>
        </xpath>

    </template>

    <!-- Líneas con serial -->
    <template id="stock_report_delivery_has_serial_move_line_inherit" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[1]" position="before">
            <td style="width:90px;">
                <img t-if="move_line.product_id.image_1024"
                     t-att-src="image_data_uri(move_line.product_id.image_1024)"
                     style="max-height:90px;max-width:90px;object-fit:contain;"/>
            </td>
        </xpath>
        <xpath expr="//td[1]" position="after">
            <td><span t-if="move_line.product_id.barcode" t-out="move_line.product_id.barcode"/></td>
        </xpath>
    </template>

    <!-- Líneas agregadas -->
    <template id="stock_report_delivery_aggregated_move_lines_inherit" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[1]" position="before">
            <td style="width:90px;">
                <img t-if="aggregated_lines[line].get('product') and aggregated_lines[line]['product'].image_1024"
                     t-att-src="image_data_uri(aggregated_lines[line]['product'].image_1024)"
                     style="max-height:90px;max-width:90px;object-fit:contain;"/>
            </td>
        </xpath>
        <xpath expr="//td[1]" position="after">
            <td><span t-if="aggregated_lines[line].get('product') and aggregated_lines[line]['product'].barcode"
                      t-out="aggregated_lines[line]['product'].barcode"/></td>
        </xpath>
    </template>

</odoo>
