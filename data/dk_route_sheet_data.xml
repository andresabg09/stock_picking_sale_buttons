<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dk_route_sheet" model="ir.sequence">
        <field name="name">Hoja de ruta</field>
        <field name="code">dk.route.sheet</field>
        <field name="prefix">HR/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <!-- Despacha las hojas de ruta programadas cuando llega su hora de salida (los pedidos En bodega pasan a
         En ruta). Corre cada 5 minutos; además, al enviar una hoja futura se agenda una ejecución exacta.
         Campos verificados contra este Odoo (18.0-20260513): ir.cron NO tiene numbercall. -->
    <record id="ir_cron_dk_depart_sheets" model="ir.cron">
        <field name="name">Hojas de ruta: despachar las programadas</field>
        <field name="model_id" ref="model_dk_route_sheet"/>
        <field name="state">code</field>
        <field name="code">model._cron_dk_depart_sheets()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
